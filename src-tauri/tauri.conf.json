{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Agentero",
	"version": "0.2.3",
	"identifier": "com.poco-ai.agentero",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Agentero",
				"dragDropEnabled": false,
				"width": 1280,
				"height": 800,
				"minWidth": 800,
				"minHeight": 520,
				"visible": false,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay",
				"trafficLightPosition": {
					"x": 14,
					"y": 18
				}
			}
		],
		"security": {
			"csp": null
		}
	},
	"plugins": {
		"fs": {
			"requireLiteralLeadingDot": false
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Productivity",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"entitlements": "./Entitlements.plist",
			"minimumSystemVersion": "12.0"
		}
	}
}
