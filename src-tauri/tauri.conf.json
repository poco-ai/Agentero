{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Agentero",
	"version": "0.1.2",
	"identifier": "com.poco-ai.agentero",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Agentero",
				"dragDropEnabled": false,
				"width": 1280,
				"height": 800,
				"minWidth": 800,
				"minHeight": 520,
				"visible": false,
				"hiddenTitle": true,
				"titleBarStyle": "Overlay",
				"trafficLightPosition": {
					"x": 14,
					"y": 18
				}
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self' 'wasm-unsafe-eval'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' blob: data: https:",
				"font-src": "'self' data:",
				"connect-src": "'self' ipc: http://ipc.localhost blob: data: https:",
				"worker-src": "'self' blob:",
				"frame-src": "'self' blob: https:",
				"object-src": "'none'"
			},
			"devCsp": {
				"default-src": "'self'",
				"script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' blob: data: https:",
				"font-src": "'self' data:",
				"connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 blob: data: https:",
				"worker-src": "'self' blob:",
				"frame-src": "'self' blob: https:",
				"object-src": "'none'"
			}
		}
	},
	"plugins": {
		"fs": {
			"requireLiteralLeadingDot": false
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
