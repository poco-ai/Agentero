{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capability for Agentero windows (main + ⌘N windows)",
	"windows": ["main", "agentero-*"],
	"permissions": [
		"core:default",
		"core:window:allow-start-dragging",
		"core:window:allow-set-focus",
		"core:window:allow-set-title",
		"core:window:allow-minimize",
		"core:window:allow-toggle-maximize",
		"core:window:allow-close",
		"core:window:allow-is-maximized",
		"core:webview:allow-create-webview-window",
		"opener:default",
		"fs:default",
		"fs:allow-read-dir",
		"fs:allow-read-file",
		"fs:allow-read-text-file",
		"fs:allow-write-text-file",
		"fs:allow-write-file",
		"fs:allow-mkdir",
		"fs:allow-remove",
		"fs:allow-stat",
		"fs:allow-exists",
		{
			"identifier": "fs:scope",
			"allow": [{ "path": "$HOME/.agentero/**" }]
		},
		"shell:default",
		"store:default",
		"dialog:default",
		"log:default"
	]
}
