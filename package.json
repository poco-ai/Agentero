{
	"name": "agentero",
	"private": true,
	"version": "0.5.2",
	"type": "module",
	"packageManager": "pnpm@11.5.3",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"clean": "node scripts/clean-build-artifacts.mjs",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"ios:release:check": "node scripts/ios-release-check.mjs",
		"demo:vault": "node test/scripts/create-demo-vault.mjs",
		"demo:vault:downloads": "node test/scripts/create-demo-vault.mjs --downloads",
		"demo:vault:empty": "node test/scripts/create-demo-vault.mjs --empty",
		"demo:vault:verify": "node test/scripts/create-demo-vault.mjs --verify",
		"probe:translator": "node test/scripts/probe-translator.mjs",
		"tauri": "tauri",
		"cli:bundle": "node scripts/prepare-bundled-cli.mjs",
		"cli:bundle:release": "node scripts/prepare-bundled-cli.mjs --release",
		"cli:bundle:stub": "node scripts/prepare-bundled-cli.mjs --stub",
		"cli:ensure": "node scripts/prepare-bundled-cli.mjs --ensure",
		"lint": "pnpm run lint:ts && pnpm run lint:rs",
		"lint:ts": "biome check .",
		"lint:rs": "cargo clippy --workspace --all-targets -- -D warnings",
		"format": "pnpm run format:ts && pnpm run format:rs",
		"format:ts": "biome format --write .",
		"format:rs": "cargo fmt --all",
		"fix": "pnpm run fix:ts && pnpm run fix:rs",
		"fix:ts": "biome check --write .",
		"fix:rs": "cargo fmt --all && pnpm run lint:rs",
		"prepare": "husky",
		"deps:check": "depcruise --config .dependency-cruiser.cjs src"
	},
	"dependencies": {
		"@embedpdf/ai": "0.0.1",
		"@embedpdf/core": "2.14.4",
		"@embedpdf/engines": "2.14.4",
		"@embedpdf/models": "2.14.4",
		"@embedpdf/pdfium": "2.14.4",
		"@embedpdf/plugin-ai-manager": "0.0.1",
		"@embedpdf/plugin-annotation": "2.14.4",
		"@embedpdf/plugin-bookmark": "2.14.4",
		"@embedpdf/plugin-document-manager": "2.14.4",
		"@embedpdf/plugin-interaction-manager": "2.14.4",
		"@embedpdf/plugin-layout-analysis": "0.0.1",
		"@embedpdf/plugin-render": "2.14.4",
		"@embedpdf/plugin-scroll": "2.14.4",
		"@embedpdf/plugin-search": "2.14.4",
		"@embedpdf/plugin-selection": "2.14.4",
		"@embedpdf/plugin-tiling": "2.14.4",
		"@embedpdf/plugin-viewport": "2.14.4",
		"@embedpdf/plugin-zoom": "2.14.4",
		"@flowershow/remark-wiki-link": "^3.4.0",
		"@fontsource-variable/geist": "^5.2.9",
		"@pdf-lib/fontkit": "^1.1.1",
		"@platejs/basic-nodes": "^53.0.0",
		"@platejs/code-block": "^53.0.0",
		"@platejs/find-replace": "^53.0.0",
		"@platejs/footnote": "^53.0.0",
