		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"shadcn": "^4.13.0",
		"shiki": "^4.3.1",
		"sonner": "^2.0.7",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.2",
		"tokenlens": "^1.3.1",
		"tw-animate-css": "^1.4.0",
