		"@streamdown/math": "^1.0.2",
		"@streamdown/mermaid": "^1.0.2",
		"@tailwindcss/vite": "^4.3.2",
		"@tanstack/react-virtual": "^3.14.6",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-deep-link": "^2.4.9",
		"@tauri-apps/plugin-dialog": "^2.7.1",
