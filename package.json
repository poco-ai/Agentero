		"lowlight": "^3.3.0",
		"lucide-react": "^1.23.0",
		"motion": "^12.42.2",
		"nanoid": "^6.0.0",
		"next-themes": "^0.4.6",
		"onnxruntime-web": "^1.27.0",
		"pdf-lib": "^1.17.1",
